# Ambika Motors – example environment variables.
# Copy this file to .env and fill in your real values (.env is ignored by git).
# Vite only exposes variables prefixed with VITE_ to the browser bundle, and everything here ends up in the
# public JavaScript, so never put private secrets in it. Restart `npm run dev` after changing any value.

# --- EmailJS (contact form on /contact-us) – see EMAILJS_SETUP.txt ---
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
